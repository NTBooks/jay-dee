# ---- Jellyfin (required) ----
# Dashboard -> Administration -> API Keys -> "+" -> name it "JayDee" -> paste the key here.
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=
# Optional: a user id (Dashboard -> Users -> click a user -> the id is in the URL). Only used for transcoded playback of exotic formats.
JELLYFIN_USER_ID=

# ---- DJ brain: OpenRouter (https://openrouter.ai/keys) ----
# Cheap models are fine here; a full 10-track set costs well under a cent on gpt-5-mini.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-mini
OPENROUTER_FAST_MODEL=openai/gpt-5-nano
# Hard guard on spend: the app refuses OpenRouter calls once today's logged spend passes this. Bulk research stays locked unless OPENROUTER_ALLOW_BULK=yes.
OPENROUTER_DAILY_CAP_USD=1.00
OPENROUTER_ALLOW_BULK=no
OPENROUTER_BULK_MODEL=openai/gpt-5-mini

# ---- Voice: any OpenAI-compatible POST /v1/audio/speech server ----
# Kokoro-FastAPI (free, local; https://github.com/remsky/Kokoro-FastAPI) is the default.
# For OpenAI's TTS instead: KOKORO_URL=https://api.openai.com  TTS_API_KEY=sk-...  TTS_MODEL=gpt-4o-mini-tts  DJ_VOICE=onyx
KOKORO_URL=http://localhost:8880
TTS_API_KEY=
TTS_MODEL=kokoro
DJ_VOICE=am_puck
DJ_VOICE_SPEED=1.0

# ---- Station identity and set shape ----
STATION_NAME=W-LLM
DJ_SET_MIN=3
DJ_SET_MAX=10
DJ_REFILL_LENGTH=6
DJ_TRACKS_PER_SEGUE=4

# ---- Research sources ----
# MusicBrainz requires a descriptive User-Agent (app name + a contact URL or email you are happy to share).
MB_USER_AGENT=JayDee/0.1 (personal radio project; https://github.com/)
LASTFM_API_KEY=
DISCOGS_TOKEN=

# ---- Taste doctrine (the DJ's system prompt; write it with the jaydee-taste skill) ----
TASTE_PROFILE_PATH=./data/taste/profile.md
# Optional extra files (comma separated) mined for "mentions" of artists/tracks, e.g. old playlist notes.
TASTE_EXTRA_FILES=

# ---- Storage, embeddings, server ----
# DATA_DIR holds everything mutable (sqlite, tts cache, models, art, taste files); DB_PATH defaults to DATA_DIR/jaydee.sqlite.
DATA_DIR=./data
DB_PATH=./data/jaydee.sqlite
EMBED_PROVIDER=local
EMBED_MODEL=Xenova/bge-small-en-v1.5
PORT=3131

# ---- Web station access ----
# Leave STATION_PASSWORD empty on a LAN. Set it before exposing the station on the internet (Coolify etc.):
# every request then needs HTTP Basic auth, and anyone without it can neither drive the show nor spend OpenRouter credit.
STATION_USER=dj
STATION_PASSWORD=

# Publishing to a deployed station (workstation only). With these set, the Catalog panel in the station header
# grows a "Publish this catalog" button that sends this machine's database to the server: no file to pick, no
# archive, no container shell. The server must have STATION_PASSWORD set.
REMOTE_STATION_URL=
REMOTE_STATION_USER=dj
REMOTE_STATION_PASSWORD=
